@model TedaInventarioWeb.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = Model.Titulo;
}

<header class="page-header py-4">
    <div class="container-fluid px-3 px-lg-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="brand-mark" aria-hidden="true">T</span>
                <div>
                    <div class="small text-uppercase fw-semibold opacity-75">TeDá Inventario</div>
                    <h1 class="h2 mb-0">Administrar usuarios</h1>
                </div>
            </div>
            <a class="btn btn-outline-light" asp-controller="Recuentos" asp-action="Nuevo">Volver al recuento</a>
        </div>
    </div>
</header>

<main class="container-fluid px-3 px-lg-4 py-4">
    <div id="usersAccessDenied" class="alert alert-danger d-none">
        No tienes permiso para administrar usuarios.
    </div>

    <section id="usersContent" class="card form-card d-none">
        <div class="card-body p-0">
            <div class="p-3 p-md-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h2 class="section-title h4 mb-1">Usuarios y permisos</h2>
                        <p class="text-secondary mb-0">Define exactamente qué puede hacer cada persona.</p>
                    </div>
                    <button id="newUserButton" class="btn btn-teda-primary" type="button">Agregar usuario</button>
                </div>
                <div class="row g-2 mt-3">
                    <div class="col-12 col-md-5">
                        <input id="userSearch" class="form-control" type="search"
                               placeholder="Buscar por nombre o usuario..." aria-label="Buscar usuarios" />
                    </div>
                    <div class="col-6 col-md-3">
                        <select id="userRoleFilter" class="form-select" aria-label="Filtrar por rol">
                            <option value="">Todos los roles</option>
                            <option>Administradora</option>
                            <option>Operaria</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select id="userStatusFilter" class="form-select" aria-label="Filtrar por estado">
                            <option value="">Todos los estados</option>
                            <option value="active">Activos</option>
                            <option value="inactive">Inactivos</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered management-table mb-0">
                    <thead>
                        <tr>
                            <th>Nombre completo</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Fecha de creación</th>
                            <th>Último acceso</th>
                            <th>Permisos</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody"></tbody>
                </table>
                <div id="emptyUsersMessage" class="empty-table-message d-none">No se encontraron usuarios.</div>
            </div>
        </div>
    </section>
</main>

<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="userForm" novalidate>
                <div class="modal-header">
                    <h2 id="userModalTitle" class="modal-title fs-5">Agregar usuario</h2>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="userFormError" class="alert alert-danger d-none" role="alert"></div>
                    <input id="userId" type="hidden" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="fullName" class="form-label">Nombre completo</label>
                            <input id="fullName" class="form-control" maxlength="100" required />
                            <div class="invalid-feedback">Ingresa el nombre completo.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="username" class="form-label">Nombre de usuario</label>
                            <input id="username" class="form-control" maxlength="40" autocomplete="off" required />
                            <div class="invalid-feedback">Ingresa un nombre de usuario.</div>
                        </div>
                        <div class="col-md-6">
                            <label id="userPasswordLabel" for="userPassword" class="form-label">Contraseña</label>
                            <input id="userPassword" class="form-control" type="password" minlength="6"
                                   autocomplete="new-password" />
                            <div id="userPasswordHelp" class="form-text">Mínimo 6 caracteres.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="userRole" class="form-label">Rol</label>
                            <select id="userRole" class="form-select" required>
                                <option>Administradora</option>
                                <option>Operaria</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input id="userActive" class="form-check-input" type="checkbox" checked />
                                <label class="form-check-label" for="userActive">Usuario activo</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <h3 class="h6 mb-0">Permisos configurables</h3>
                        <div class="d-flex flex-wrap gap-2">
                            <button id="selectAllPermissions" class="btn btn-sm btn-outline-primary" type="button">Seleccionar todos</button>
                            <button id="clearAllPermissions" class="btn btn-sm btn-outline-secondary" type="button">Quitar todos</button>
                        </div>
                    </div>
                    <div class="permissions-scroll"><div class="row g-2">
                        @foreach (var permiso in Model.PermisosDisponibles)
                        {
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="permission-item">
                                    <input class="form-check-input permission-checkbox" type="checkbox"
                                           value="@permiso.Codigo" id="permission-@permiso.Codigo" />
                                    <label class="form-check-label" for="permission-@permiso.Codigo">
                                        @permiso.Nombre
                                        <small>@permiso.Modulo</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                    <button id="userSaveButton" class="btn btn-teda-primary" type="submit">Guardar permisos</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="userToast" class="toast border-0" role="status">
        <div class="d-flex">
            <div id="userToastBody" class="toast-body"></div>
            <button class="btn-close me-2 m-auto" type="button" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}
