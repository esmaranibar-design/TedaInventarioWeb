@model TedaInventarioWeb.ViewModels.ImportarProductosViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<header class="page-header py-4">
    <div class="container-fluid px-3 px-lg-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="brand-mark" aria-hidden="true">T</span>
                <div>
                    <div class="small text-uppercase fw-semibold opacity-75">TeDá Inventario</div>
                    <h1 class="h2 mb-0">@Model.Titulo</h1>
                </div>
            </div>
            <a class="btn btn-outline-light" asp-controller="Recuentos" asp-action="Nuevo">Volver al recuento</a>
        </div>
    </div>
</header>

<main class="container-fluid px-3 px-lg-4 py-4">
    <div id="importAccessDenied" class="alert alert-danger d-none" role="alert">
        <h2 class="h5">Acceso no autorizado</h2>
        Tu usuario no tiene permiso para importar productos. Solicítalo a la administradora principal.
    </div>

    <div id="importApplication" class="d-none">
        <section class="card form-card mb-4">
            <div class="card-body p-3 p-md-4">
                <h2 class="section-title h4">Seleccionar archivo</h2>
                <p class="text-secondary">
                    Usa un archivo <strong>.xlsx</strong> de hasta 30 MB. Primero se analizará y mostrará una vista previa;
                    ningún dato se guarda automáticamente.
                </p>
                <form id="excelImportForm" novalidate>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-lg-8">
                            <label for="excelFile" class="form-label required-label">Archivo de productos</label>
                            <input id="excelFile" name="archivo" class="form-control" type="file"
                                   accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                            <div class="form-text">El archivo original nunca será modificado.</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <button id="analyzeExcelButton" class="btn btn-teda-primary w-100" type="submit">
                                Analizar archivo
                            </button>
                        </div>
                    </div>
                </form>
                <div id="importMessage" class="alert mt-3 mb-0 d-none" role="status"></div>
            </div>
        </section>

        <section id="importPreview" class="d-none">
            <div class="import-stat-grid mb-4">
                <div class="import-stat"><span id="statCompanies">0</span><small>Empresas</small></div>
                <div class="import-stat"><span id="statProducts">0</span><small>Productos únicos</small></div>
                <div class="import-stat"><span id="statDuplicates">0</span><small>Duplicados omitidos</small></div>
                <div class="import-stat"><span id="statReview">0</span><small>Para revisar</small></div>
            </div>

            <section class="card form-card mb-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
                        <div>
                            <h2 class="section-title h4 mb-1">Vista previa de importación</h2>
                            <p id="previewSummary" class="text-secondary mb-0"></p>
                        </div>
                        <div class="import-filter">
                            <label for="resultFilter" class="form-label">Mostrar</label>
                            <select id="resultFilter" class="form-select">
                                <option value="Todos">Todos</option>
                                <option value="Nuevo">Nuevos</option>
                                <option value="Será actualizado">Serán actualizados</option>
                                <option value="Ya existe">Ya existen</option>
                                <option value="Requiere revisión">Requieren revisión</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="table-responsive import-table-region" tabindex="0">
                    <table class="table table-bordered import-table mb-0">
                        <thead>
                            <tr>
                                <th>Resultado</th><th>Código</th><th>Empresa</th><th>Producto</th>
                                <th>Presentación</th><th>Cant. paquete</th><th>Precio venta</th>
                                <th>Precio costo</th><th>Stock mínimo</th><th>Origen</th>
                            </tr>
                        </thead>
                        <tbody id="importPreviewBody"></tbody>
                    </table>
                    <div id="emptyImportPreview" class="empty-table-message d-none">No hay registros para este filtro.</div>
                </div>
            </section>

            <div class="action-buttons d-flex flex-wrap justify-content-end gap-2 mb-5">
                <button id="cancelImportButton" class="btn btn-outline-secondary" type="button">Cancelar</button>
                <button id="downloadCatalogButton" class="btn btn-teda-yellow" type="button">Descargar catálogo limpio</button>
                <button id="confirmImportButton" class="btn btn-teda-primary" type="button">Confirmar importación</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        window.tedaImportOptions = {
            analyzeUrl: "@Url.Action("Analizar", "Importacion")",
            maxBytes: @Model.TamanoMaximoBytes
        };
    </script>
    <script src="~/js/importacion-productos.js" asp-append-version="true"></script>
}
